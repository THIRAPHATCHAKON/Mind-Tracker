generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  verified  Boolean  @default(false)
  verifyToken String?
  verifyTokenExpiry DateTime?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habitGroups  HabitGroup[]
  habits       Habit[]
  completions  Completion[]
}

model HabitGroup {
  id        String   @id @default(cuid())
  userId    String
  name      String
  order     Int      @default(0)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@index([userId])
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  groupId   String?
  name      String
  category  String   @default("general")
  color     String   @default("#6366f1")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      HabitGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  completions Completion[]

  @@index([userId])
  @@index([groupId])
}

model Completion {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      DateTime
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, date])
  @@index([userId])
  @@index([habitId])
  @@index([userId, habitId, date])
}
